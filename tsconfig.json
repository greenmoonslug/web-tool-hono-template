{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "vite/client"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"public/**/*.js",
		"api/**/*.ts",
		"_db/**/*.ts",
		"vite.config.ts",
		"svelte.config.js",
		"prettier.config.js",
		"eslint.config.js",
		"playwright.config.ts"
	]
}
